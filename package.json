{
  "name": "el-bravo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:colors": "node scripts/check-colors.mjs",
    "typecheck": "tsc --noEmit",
