# MySQL 8 / MariaDB. El usuario necesita permiso de CREATE global para la shadow DB de `prisma migrate dev`.
DATABASE_URL="mysql://elbravo:CHANGE_ME@127.0.0.1:3306/elbravo"

# Secreto para firmar los JWT de sesión (ej: `openssl rand -hex 32`)
JWT_SECRET="CHANGE_ME"

# Opcional, por defecto "elbravo_token"
JWT_COOKIE_NAME="elbravo_token"

# Secreto de los crons (`Authorization: Bearer $CRON_SECRET`), ej: `openssl rand -hex 32`
CRON_SECRET="CHANGE_ME"

# Base de datos de tests de integración (la crea `npm run db:worktree`)
DATABASE_URL_TEST="mysql://elbravo:CHANGE_ME@127.0.0.1:3306/elbravo_test"

# Fotos: Cloudflare R2 (API S3). Ver docs/r2-setup.md.
# Account ID del dashboard de Cloudflare (R2 → Overview). El endpoint queda https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID="CHANGE_ME"
# API token de R2 con permiso "Object Read & Write" limitado al bucket
R2_ACCESS_KEY_ID="CHANGE_ME"
R2_SECRET_ACCESS_KEY="CHANGE_ME"
R2_BUCKET="elbravo-media"
# Dominio público de lectura del bucket (dominio propio o r2.dev), sin barra final
R2_PUBLIC_BASE_URL="https://media.example.com"
# Solo para desarrollo con MinIO local (path-style). En producción, dejarlo sin definir.
# R2_ENDPOINT="http://127.0.0.1:9000"

# Email (Resend). Sin RESEND_API_KEY el canal email queda apagado (el cron loguea "email deshabilitado").
RESEND_API_KEY=""
EMAIL_FROM="El Bravo <hola@CAMBIAR_DOMINIO>"
# URL pública de la app (links de los emails y de las notificaciones push), sin barra final
APP_URL="http://localhost:3000"
