# MySQL 8 / MariaDB. El usuario necesita permiso de CREATE global para la shadow DB de `prisma migrate dev`.
DATABASE_URL="mysql://elbravo:CHANGE_ME@127.0.0.1:3306/elbravo"

# Secreto para firmar los JWT de sesión (ej: `openssl rand -hex 32`)
JWT_SECRET="CHANGE_ME"

# Opcional, por defecto "elbravo_token"
JWT_COOKIE_NAME="elbravo_token"
